[Unit]
Description=Prism KVM manager
Wants=network-online.target
After=network-online.target libvirtd.service virtqemud.service

[Service]
ExecStart=/usr/local/bin/prism serve --config /etc/prism
Restart=on-failure
RestartSec=2

# Prism manages netlink links, nftables, WireGuard, libvirt pool directories
# and AppArmor rule files, so it runs as root with a trimmed capability set.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_MAC_ADMIN CAP_SYS_ADMIN
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK AF_PACKET
SystemCallArchitectures=native
ProtectClock=yes
ProtectHostname=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
PrivateTmp=yes

# The file system is read-only except for the paths below. Add every pool and
# archive directory that lives outside /var/lib/prism to ReadWritePaths, and
# remove ProtectHome if one of them is under /home.
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/etc/prism /var/lib/prism /run/prism /run/libvirt /etc/apparmor.d

[Install]
WantedBy=multi-user.target
